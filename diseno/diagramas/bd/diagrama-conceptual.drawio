<mxfile host="app.diagrams.net">
  <diagram name="Page-1" id="tSe0lPrmWH4DprmfF71Z">
    <mxGraphModel dx="1369" dy="757" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    %% ============================================================\n    %% MODULO D - VENTAS Y POSTVENTA (version corregida)\n    %% Esquema M1 (Ventas) y Esquema M2 (Postventa) son bases de\n    %% datos independientes (Database-per-Service, RNF-07).\n    %% Ninguna relacion cruza fisicamente de un esquema a otro.\n    %% Los campos idPedido / idAnulacion / idDevolucion que hacen\n    %% referencia a datos de OTRO esquema se dejan como atributo\n    %% escalar simple (comentado como \&quot;referencia API\&quot;), SIN linea\n    %% de relacion dibujada entre entidades de distinto esquema.\n    %% ============================================================\n\n    %% ---------- Relaciones dentro de M1 (mismo esquema, FK fisica) ----------\n    PEDIDO ||--o{ DETALLE_PEDIDO : contiene\n    PEDIDO ||--o{ PAGO : registra\n    PEDIDO ||--o{ HISTORIAL_ESTADO : audita\n    PEDIDO ||--o| ANULACION : \&quot;puede tener (F2)\&quot;\n\n    %% ---------- Relaciones dentro de M2 (mismo esquema, FK fisica) ----------\n    DEVOLUCION ||--o| REEMBOLSO : origina\n    DEVOLUCION ||--o{ EVIDENCIA_DEVOLUCION : adjunta\n\n    %% ---------- NO se dibujan relaciones entre M1 y M2 ----------\n    %% PEDIDO &lt;-&gt; DEVOLUCION      : referencia API por idPedido (sin linea)\n    %% PEDIDO &lt;-&gt; RECLAMO         : referencia API por idPedido (sin linea)\n    %% PEDIDO &lt;-&gt; CALIFICACION    : referencia API por idPedido (sin linea)\n    %% ANULACION &lt;-&gt; REEMBOLSO    : referencia API por idOrigen (sin linea)\n\n    %% ============================================================\n    %% ESQUEMA M1 - VENTAS\n    %% ============================================================\n\n    PEDIDO {\n        int id PK\n        string codigo\n        string canal\n        date fecha\n        string estado\n        string moneda\n        decimal subtotal\n        decimal descuento\n        decimal total\n        string nombreContacto\n        string tipoDocumento\n        string numeroDocumento\n        string telefono\n        string email\n        string modalidadEnvio\n        decimal costoEnvio\n        string destinatario\n        string distrito\n        string direccion\n        string codigoCupon\n        datetime creadoEn\n        int idCliente \&quot;referencia externa - modulo G\&quot;\n        int idVendedor \&quot;referencia externa - modulo G\&quot;\n        int idDireccionEntrega \&quot;referencia externa - modulo E\&quot;\n    }\n\n    DETALLE_PEDIDO {\n        int id PK\n        int idPedido FK\n        int idProducto \&quot;referencia externa - modulo F\&quot;\n        string sku\n        string descripcion\n        int cantidad\n        decimal precioUnitario\n        decimal descuento\n        decimal importe\n    }\n\n    PAGO {\n        int id PK\n        int idPedido FK\n        string metodo\n        string referencia\n        decimal monto\n        string estado\n        datetime fechaProceso\n    }\n\n    HISTORIAL_ESTADO {\n        int id PK\n        int idPedido FK\n        string estadoAnterior\n        string estadoNuevo\n        string actor \&quot;CLIENTE, GESTOR, CANAL_CHATBOT, PASARELA_PAGOS, SISTEMA_LOGISTICA\&quot;\n        string motivo \&quot;incluye valores como PAGO_NO_COMPLETADO\&quot;\n        datetime fechaHora\n    }\n\n    ANULACION {\n        int id PK\n        int idPedido FK\n        string motivo\n        int idSolicitante\n        int idAutorizador\n        string estado\n        date fecha\n    }\n\n    %% ============================================================\n    %% ESQUEMA M2 - POSTVENTA (base de datos independiente de M1)\n    %% ============================================================\n\n    DEVOLUCION {\n        int id PK\n        int idPedido \&quot;referencia API - Pedido vive en M1, sin FK fisica\&quot;\n        string tipo\n        string motivo\n        string estado\n        string resolucion\n        int idAutorizador\n        string fundamentoRechazo\n        date fecha\n    }\n\n    EVIDENCIA_DEVOLUCION {\n        int id PK\n        int idDevolucion FK\n        string url\n        string tipo\n        date fecha\n    }\n\n    RECLAMO {\n        int id PK\n        string codigo UK\n        int idPedido \&quot;referencia API opcional - Pedido vive en M1, sin FK fisica\&quot;\n        string tipo\n        string motivo\n        string detalle\n        string nombreConsumidor\n        string documento\n        string email\n        string telefono\n        string estado\n        int plazoDiasHabiles\n        date fechaLimiteRespuesta\n        string respuestaVisibleCliente\n    }\n\n    REEMBOLSO {\n        int id PK\n        int idOrigen \&quot;referencia API - Anulacion (M1) o Devolucion (M2), sin FK fisica hacia M1\&quot;\n        string tipoOrigen \&quot;unicamente ANULACION o DEVOLUCION\&quot;\n        string idempotencyKey\n        decimal monto\n        string moneda\n        string idTransaccion\n        string estado \&quot;PENDIENTE, EXITOSO o FALLIDO\&quot;\n        int idAutorizador\n        date fecha\n    }\n\n    CALIFICACION {\n        int id PK\n        int idPedido \&quot;referencia API - Pedido vive en M1, sin FK fisica\&quot;\n        int puntaje\n        string comentario\n        string canal\n        date fecha\n    }\n\n    AGREGADO_VENTAS {\n        string periodo PK\n        string canal PK\n        int idVendedor PK\n        int idProducto PK\n        int unidades\n        decimal monto\n        datetime actualizadoEn\n    }&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="jdGgm2eAHYpInPSv7ftY-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
